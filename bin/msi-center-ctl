#!/bin/bash
# msi-center-ctl — Hardware & telemetry controller for oma.msi-center Omarchy plugin.
# Supports MSI laptops & desktops across Intel & AMD platforms via sysfs,
# msi_wmi_platform, msi-ec, validated ec_sys (MSI EMS register map),
# powerprofilesctl, nvidia-smi / amdgpu sysfs, and MysticLight USB HID / sysfs LEDs.

set -uo pipefail

SCRIPT_PATH="$(realpath "$0")"
USER_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/msi-center"
SYS_STATE_DIR="/var/lib/msi-center"
MSI_EC_DIR="/sys/devices/platform/msi-ec"
EC_IO="/sys/kernel/debug/ec/ec0/io"
ANIM_PID_FILE="$USER_STATE_DIR/mystic-anim.pid"

mkdir -p "$USER_STATE_DIR" 2>/dev/null || true

STATE_FILE="$USER_STATE_DIR/state.json"
if [[ -f "$SYS_STATE_DIR/state.json" ]]; then
  if [[ ! -f "$STATE_FILE" || "$SYS_STATE_DIR/state.json" -nt "$STATE_FILE" ]]; then
    STATE_FILE="$SYS_STATE_DIR/state.json"
  fi
fi

read_state_key() {
  local key="$1" fallback="$2"
  if [[ -f "$STATE_FILE" ]]; then
    local val
    val=$(jq -r --arg k "$key" '.[$k] // empty' "$STATE_FILE" 2>/dev/null || true)
    if [[ -n "$val" && "$val" != "null" ]]; then
      printf '%s' "$val"
      return
    fi
  fi
  printf '%s' "$fallback"
}

write_state_kv() {
  local key="$1" val="$2"
  local current="{}"
  if [[ -f "$STATE_FILE" ]]; then
    current=$(cat "$STATE_FILE" 2>/dev/null || echo "{}")
  fi
  if ! echo "$current" | jq -e . >/dev/null 2>&1; then
    current="{}"
  fi
  local updated
  updated=$(echo "$current" | jq --arg k "$key" --arg v "$val" '.[$k] = $v')
  mkdir -p "$USER_STATE_DIR" 2>/dev/null || true
  printf '%s\n' "$updated" > "$USER_STATE_DIR/state.json" 2>/dev/null || true
  if [[ $EUID -eq 0 ]]; then
    mkdir -p "$SYS_STATE_DIR" 2>/dev/null || true
    chmod 755 "$SYS_STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$updated" > "$SYS_STATE_DIR/state.json" 2>/dev/null || true
    chmod 644 "$SYS_STATE_DIR/state.json" 2>/dev/null || true
    local target_uid="${PKEXEC_UID:-}"
    if [[ -z "$target_uid" ]]; then
      target_uid=$(stat -c '%u' "$SCRIPT_PATH" 2>/dev/null || echo "")
    fi
    if [[ -n "$target_uid" && "$target_uid" != "0" ]]; then
      local uhome
      uhome=$(getent passwd "$target_uid" | cut -d: -f6)
      if [[ -n "$uhome" && -d "$uhome" ]]; then
        mkdir -p "$uhome/.local/state/msi-center" 2>/dev/null || true
        printf '%s\n' "$updated" > "$uhome/.local/state/msi-center/state.json" 2>/dev/null || true
        chown -R "$target_uid:$target_uid" "$uhome/.local/state/msi-center" 2>/dev/null || true
      fi
    fi
  fi
}

find_mystic_hidraw() {
  for h in /sys/class/hidraw/hidraw*; do
    if [[ ! -e "$h/device/uevent" ]]; then
      continue
    fi
    if grep -qiE "00001462:0000(1603|1562|1563|1564)" "$h/device/uevent" 2>/dev/null; then
      echo "/dev/$(basename "$h")"
      return 0
    fi
  done
  return 1
}

ensure_ec_sys() {
  if [[ -w "$EC_IO" ]]; then
    return 0
  fi
  if [[ $EUID -ne 0 ]]; then
    return 1
  fi
  if [[ ! -e "$EC_IO" ]]; then
    modprobe ec_sys write_support=1 2>/dev/null || true
  fi
  if [[ -e "/sys/module/ec_sys/parameters/write_support" ]]; then
    local ws
    ws=$(cat /sys/module/ec_sys/parameters/write_support 2>/dev/null || echo "N")
    if [[ "$ws" != "Y" && "$ws" != "1" ]]; then
      modprobe -r ec_sys 2>/dev/null || true
      modprobe ec_sys write_support=1 2>/dev/null || true
    fi
  fi
  if [[ -e "$EC_IO" ]]; then
    chmod 755 /sys/kernel/debug /sys/kernel/debug/ec /sys/kernel/debug/ec/ec0 2>/dev/null || true
    chmod 666 "$EC_IO" 2>/dev/null || true
    return 0
  fi
  return 1
}

# Verify that the system is an MSI laptop with a genuine MSI Embedded Controller
# firmware string at 0xA0..0xAB (e.g. "17T2EMS1.110") before writing raw EC bytes.
is_msi_laptop_ec() {
  local chassis_type=10
  if [[ -r /sys/devices/virtual/dmi/id/chassis_type ]]; then
    chassis_type=$(cat /sys/devices/virtual/dmi/id/chassis_type 2>/dev/null || echo 10)
  fi
  case "$chassis_type" in
    8|9|10|11|14|30|31|32) ;;
    *) return 1 ;;
  esac
  if [[ ! -r "$EC_IO" ]]; then
    ensure_ec_sys || return 1
  fi
  python3 - "$EC_IO" <<'PY' 2>/dev/null
import re, sys
with open(sys.argv[1], "rb") as f:
    f.seek(0xA0)
    fw = f.read(12).decode("ascii", errors="ignore").strip("\x00 ")
sys.exit(0 if re.match(r"^[0-9A-Z]{4}EMS[0-9]\.[0-9A-Z]{3}$", fw) else 1)
PY
}

# Detect whether battery charge control lives at 0xD7 (Gen-2 MSI EC) or 0xEF (Gen-1 MSI EC).
detect_battery_ec_reg() {
  if [[ -r "$EC_IO" ]]; then
    python3 - "$EC_IO" <<'PY' 2>/dev/null
import sys
with open(sys.argv[1], "rb") as f:
    data = f.read(256)
d7 = data[0xD7] if len(data) > 0xD7 else 0
ef = data[0xEF] if len(data) > 0xEF else 0
if (d7 & 0x80) and (50 <= (d7 & 0x7F) <= 100):
    print("0xD7")
elif (ef & 0x80) and (50 <= (ef & 0x7F) <= 100):
    print("0xEF")
else:
    print("0xD7")
PY
  else
    echo "0xD7"
  fi
}

# Automatically provision udev + systemd-tmpfiles + ec_sys whenever executed as root
# (via pkexec on first action) so subsequent actions run directly as the user.
ensure_permissions_bootstrap() {
  if [[ $EUID -ne 0 ]]; then
    return 0
  fi
  ensure_ec_sys || true

  local hiddev
  hiddev=$(find_mystic_hidraw || true)
  if [[ -n "$hiddev" ]]; then
    chmod 666 "$hiddev" 2>/dev/null || true
  fi

  for p in \
    /sys/devices/system/cpu/intel_pstate/no_turbo \
    /sys/devices/system/cpu/cpufreq/boost \
    /sys/devices/platform/msi-ec/shift_mode \
    /sys/devices/platform/msi-ec/fan_mode \
    /sys/devices/platform/msi-ec/cooler_boost \
    /sys/devices/platform/msi-ec/super_battery \
    /sys/devices/platform/msi-ec/webcam \
    /sys/devices/platform/msi-ec/win_key \
    /sys/devices/platform/msi-ec/usb_power \
    /sys/devices/platform/msi-ec/kbd_backlight; do
    if [[ -e "$p" ]]; then
      chmod 666 "$p" 2>/dev/null || true
    fi
  done

  for bat in /sys/class/power_supply/BAT*; do
    if [[ -e "$bat/charge_control_end_threshold" ]]; then
      chmod 666 "$bat/charge_control_end_threshold" 2>/dev/null || true
    fi
    if [[ -e "$bat/charge_control_start_threshold" ]]; then
      chmod 666 "$bat/charge_control_start_threshold" 2>/dev/null || true
    fi
  done

  install -d -m 755 /etc/modules-load.d /etc/modprobe.d /etc/udev/rules.d /etc/tmpfiles.d "$SYS_STATE_DIR" 2>/dev/null || true
  printf 'ec_sys\n' > /etc/modules-load.d/msi-center.conf 2>/dev/null || true
  printf 'options ec_sys write_support=1\n' > /etc/modprobe.d/msi-center.conf 2>/dev/null || true

  cat <<'EOF' > /etc/udev/rules.d/60-msi-mysticlight.rules 2>/dev/null || true
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="1603", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="1562", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="1563", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="1564", MODE="0666"
EOF

  cat <<'EOF' > /etc/tmpfiles.d/msi-center.conf 2>/dev/null || true
z /sys/kernel/debug 0755 root root - -
z /sys/kernel/debug/ec 0755 root root - -
z /sys/kernel/debug/ec/ec0 0755 root root - -
z /sys/kernel/debug/ec/ec0/io 0666 root root - -
z /sys/devices/system/cpu/intel_pstate/no_turbo 0666 root root - -
z /sys/devices/system/cpu/cpufreq/boost 0666 root root - -
EOF

  udevadm control --reload >/dev/null 2>&1 || true
  udevadm trigger --subsystem-match=hidraw >/dev/null 2>&1 || true
  if [[ -n "$hiddev" ]]; then
    chmod 666 "$hiddev" 2>/dev/null || true
  fi
  write_state_kv "permissionsSetup" "true"
}

ec_read_byte() {
  local offset_hex="$1"
  if [[ -r "$EC_IO" ]]; then
    python3 - "$EC_IO" "$offset_hex" <<'PY' 2>/dev/null || true
import sys
path, off = sys.argv[1], int(sys.argv[2], 16)
with open(path, "rb") as f:
    f.seek(off)
    b = f.read(1)
    if b:
        print(b[0])
PY
  fi
}

ec_write_byte() {
  local offset_hex="$1" val_hex="$2"
  if [[ ! -w "$EC_IO" ]]; then
    ensure_ec_sys || return 1
  fi
  is_msi_laptop_ec || return 1
  python3 - "$EC_IO" "$offset_hex" "$val_hex" <<'PY' 2>/dev/null
import sys
path, off, val = sys.argv[1], int(sys.argv[2], 16), int(sys.argv[3], 16)
with open(path, "r+b", buffering=0) as f:
    f.seek(off)
    f.write(bytes([val & 0xFF]))
PY
}

ec_set_bit() {
  local offset_hex="$1" bit="$2" state="$3"
  if [[ ! -w "$EC_IO" ]]; then
    ensure_ec_sys || return 1
  fi
  is_msi_laptop_ec || return 1
  python3 - "$EC_IO" "$offset_hex" "$bit" "$state" <<'PY' 2>/dev/null
import sys
path, off, bit, state = sys.argv[1], int(sys.argv[2], 16), int(sys.argv[3]), sys.argv[4]
with open(path, "r+b", buffering=0) as f:
    f.seek(off)
    cur = f.read(1)
    val = cur[0] if cur else 0
    if state in ("1", "on", "true"):
        val |= (1 << bit)
    else:
        val &= ~(1 << bit)
    f.seek(off)
    f.write(bytes([val & 0xFF]))
PY
}

ec_set_mask() {
  local offset_hex="$1" mask_hex="$2" state="$3"
  if [[ ! -w "$EC_IO" ]]; then
    ensure_ec_sys || return 1
  fi
  is_msi_laptop_ec || return 1
  python3 - "$EC_IO" "$offset_hex" "$mask_hex" "$state" <<'PY' 2>/dev/null
import sys
path, off, mask, state = sys.argv[1], int(sys.argv[2], 16), int(sys.argv[3], 16), sys.argv[4]
with open(path, "r+b", buffering=0) as f:
    f.seek(off)
    cur = f.read(1)
    val = cur[0] if cur else 0
    if state in ("1", "on", "true"):
        val |= mask
    else:
        val &= ~mask
    f.seek(off)
    f.write(bytes([val & 0xFF]))
PY
}

apply_cpu_boost_hw() {
  local enable_boost="$1"
  local no_turbo="0"
  if [[ "$enable_boost" == "0" ]]; then
    no_turbo="1"
  fi

  if [[ -w /sys/devices/system/cpu/intel_pstate/no_turbo ]]; then
    echo "$no_turbo" > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
  fi
  if [[ -w /sys/devices/system/cpu/cpufreq/boost ]]; then
    echo "$enable_boost" > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || true
  fi
}

stop_mystic_anim() {
  if [[ -f "$ANIM_PID_FILE" ]]; then
    python3 - "$ANIM_PID_FILE" <<'PY' 2>/dev/null || true
import os, signal, sys
pid_file = sys.argv[1]
try:
    with open(pid_file, "r") as f:
        pid = int(f.read().strip())
    if pid > 1:
        os.kill(pid, signal.SIGTERM)
except Exception:
    pass
try:
    os.remove(pid_file)
except Exception:
    pass
PY
  fi
}

apply_mystic_hw() {
  local mode="$1" hex="$2" bright="$3" speed="${4:-50}"
  local clean_hex="${hex#\#}"
  local r=$((16#${clean_hex:0:2}))
  local g=$((16#${clean_hex:2:2}))
  local b=$((16#${clean_hex:4:2}))

  stop_mystic_anim

  # 1. EC hardware backlight level (CONF_G2_10: 0xD3 -> 0x80=off, 0x81=low, 0x82=med, 0x83=high)
  local ec_bl="0x83"
  local msi_ec_bl="3"
  if [[ "$mode" == "off" || "$bright" -le 0 ]]; then
    ec_bl="0x80"
    msi_ec_bl="0"
  elif (( bright <= 35 )); then
    ec_bl="0x81"
    msi_ec_bl="1"
  elif (( bright <= 70 )); then
    ec_bl="0x82"
    msi_ec_bl="2"
  else
    ec_bl="0x83"
    msi_ec_bl="3"
  fi

  if [[ -w "$MSI_EC_DIR/kbd_backlight" ]]; then
    echo "$msi_ec_bl" > "$MSI_EC_DIR/kbd_backlight" 2>/dev/null || true
  elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
    ec_write_byte 0xD3 "$ec_bl" || true
    if [[ "$ec_bl" != "0x80" ]]; then
      ec_write_byte 0x2C 0x00 || true
    fi
  fi

  # 2. Standard sysfs kbd_backlight if available
  for led in /sys/class/leds/*kbd_backlight*; do
    if [[ ! -d "$led" ]]; then
      continue
    fi
    if [[ -w "$led/brightness" && -r "$led/max_brightness" ]]; then
      local maxb newb
      maxb=$(cat "$led/max_brightness" 2>/dev/null || echo 3)
      if [[ "$mode" == "off" || "$bright" -le 0 ]]; then
        newb=0
      else
        newb=$(( (bright * maxb + 50) / 100 ))
        if (( newb < 1 )); then
          newb=1
        fi
      fi
      echo "$newb" > "$led/brightness" 2>/dev/null || true
    fi
    if [[ -w "$led/multi_intensity" ]]; then
      echo "$r $g $b" > "$led/multi_intensity" 2>/dev/null || true
    fi
  done

  # 3. Direct HID feature report sequence for MSI MysticLight USB HID (1462:1603 / 1562 / 1563 / 1564)
  local hiddev
  hiddev=$(find_mystic_hidraw || true)
  if [[ -n "$hiddev" && -w "$hiddev" ]]; then
    python3 - "$hiddev" "$mode" "$r" "$g" "$b" "$bright" "$speed" "$ANIM_PID_FILE" <<'PY'
import colorsys, fcntl, math, os, signal, sys, time

dev = sys.argv[1]
mode = sys.argv[2]
r = max(0, min(255, int(sys.argv[3])))
g = max(0, min(255, int(sys.argv[4])))
b = max(0, min(255, int(sys.argv[5])))
bright = max(0, min(100, int(sys.argv[6])))
speed = max(5, min(100, int(sys.argv[7])))
pid_file = sys.argv[8]

# HIDIOCSFEATURE(64) = 0xC0404806
IOCTL_SET_FEATURE_64 = 0xC0004806 | (64 << 16)

# Map speed (5..100) to hardware transition byte (100..5, smaller = faster transition)
transition_byte = max(4, min(100, 104 - speed))
bright_scale = bright / 100.0

def scale_rgb(cr, cg, cb, factor):
    f = max(0.0, min(1.0, factor))
    sr = int(round(cr * f))
    sg = int(round(cg * f))
    sb = int(round(cb * f))
    if f > 0.0 and (cr > 0 or cg > 0 or cb > 0) and sr == 0 and sg == 0 and sb == 0:
        if cr >= cg and cr >= cb:
            sr = 1
        elif cg >= cr and cg >= cb:
            sg = 1
        else:
            sb = 1
    return sr, sg, sb

def build_global_prep():
    buf = bytearray(64)
    buf[0] = 0x02
    buf[1] = 0x01
    for i in range(2, 34):
        buf[i] = 0xFF
    return buf

def build_zone_prep(zone_idx):
    buf = bytearray(64)
    buf[0] = 0x02
    buf[1] = 0x01
    mask = 1 << zone_idx
    buf[2] = mask & 0xFF
    buf[3] = (mask >> 8) & 0xFF
    buf[4] = (mask >> 16) & 0xFF
    buf[5] = (mask >> 24) & 0xFF
    return buf

def build_color_pkt(cr, cg, cb, active=True, transition=0x32, effect=0x08):
    buf = bytearray(64)
    buf[0] = 0x02
    buf[1] = 0x02
    buf[2] = 0x01
    buf[3] = 0x58
    buf[4] = 0x02
    buf[5] = 0x00
    buf[6] = transition & 0xFF
    buf[7] = effect & 0xFF
    buf[8] = 0x01
    buf[9] = 0x01
    buf[10] = 0x00
    buf[11] = cr & 0xFF
    buf[12] = cg & 0xFF
    buf[13] = cb & 0xFF
    buf[14] = 0x64 if active else 0x00
    buf[15] = cr & 0xFF
    buf[16] = cg & 0xFF
    buf[17] = cb & 0xFF
    return buf

fd = os.open(dev, os.O_RDWR | os.O_NONBLOCK)
try:
    if mode == "off" or bright <= 0:
        fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_global_prep())
        fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_color_pkt(0, 0, 0, active=False, transition=transition_byte))
        sys.exit(0)
    elif mode == "steady":
        sr, sg, sb = scale_rgb(r, g, b, bright_scale)
        fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_global_prep())
        fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_color_pkt(sr, sg, sb, active=True, transition=transition_byte))
        sys.exit(0)
    elif mode == "breathing":
        sr, sg, sb = scale_rgb(r, g, b, bright_scale)
        fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_global_prep())
        fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_color_pkt(sr, sg, sb, active=True, transition=transition_byte))
    elif mode == "wave":
        for z in range(24):
            col = z % 12
            row = z // 12
            hue = ((col / 12.0) + (0.04 if row else 0.0)) % 1.0
            rf, gf, bf = colorsys.hsv_to_rgb(hue, 1.0, bright_scale)
            zr, zg, zb = int(round(rf * 255)), int(round(gf * 255)), int(round(bf * 255))
            fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_zone_prep(z))
            fcntl.ioctl(fd, IOCTL_SET_FEATURE_64, build_color_pkt(zr, zg, zb, active=True, transition=transition_byte))
finally:
    os.close(fd)

# Spawn detached background animator for dynamic modes (breathing / wave)
pid = os.fork()
if pid > 0:
    sys.exit(0)

os.setsid()
pid2 = os.fork()
if pid2 > 0:
    os._exit(0)

devnull = os.open("/dev/null", os.O_RDWR)
os.dup2(devnull, 0)
os.dup2(devnull, 1)
os.dup2(devnull, 2)
if devnull > 2:
    os.close(devnull)

try:
    os.makedirs(os.path.dirname(pid_file), exist_ok=True)
    with open(pid_file, "w") as pf:
        pf.write(str(os.getpid()))
except Exception:
    pass

running = True
def handle_stop(signum, frame):
    global running
    running = False

signal.signal(signal.SIGTERM, handle_stop)
signal.signal(signal.SIGINT, handle_stop)

anim_fd = os.open(dev, os.O_RDWR | os.O_NONBLOCK)
try:
    t0 = time.monotonic()
    period = max(0.55, 4.15 - 0.036 * speed)
    phase = 0.0
    while running:
        try:
            with open(pid_file, "r") as pf:
                if int(pf.read().strip()) != os.getpid():
                    break
        except Exception:
            break

        if mode == "breathing":
            elapsed = time.monotonic() - t0
            wave_val = 0.5 * (1.0 + math.cos(2.0 * math.pi * elapsed / period))
            pulse = 0.04 + 0.96 * (wave_val ** 1.6)
            cr, cg, cb = scale_rgb(r, g, b, bright_scale * pulse)
            fcntl.ioctl(anim_fd, IOCTL_SET_FEATURE_64, build_global_prep())
            fcntl.ioctl(anim_fd, IOCTL_SET_FEATURE_64, build_color_pkt(cr, cg, cb, active=True, transition=transition_byte))
            time.sleep(0.045)
        elif mode == "wave":
            step_hue = 0.006 + 0.075 * (speed / 100.0)
            phase = (phase - step_hue) % 1.0
            for z in range(24):
                col = z % 12
                row = z // 12
                hue = (phase + (col / 12.0) + (0.03 if row else 0.0)) % 1.0
                rf, gf, bf = colorsys.hsv_to_rgb(hue, 1.0, bright_scale)
                zr, zg, zb = int(round(rf * 255)), int(round(gf * 255)), int(round(bf * 255))
                fcntl.ioctl(anim_fd, IOCTL_SET_FEATURE_64, build_zone_prep(z))
                fcntl.ioctl(anim_fd, IOCTL_SET_FEATURE_64, build_color_pkt(zr, zg, zb, active=True, transition=transition_byte))
            time.sleep(0.065)
        else:
            break
finally:
    os.close(anim_fd)
PY
  fi
}

cmd_scenario() {
  local sc="${1:-balanced}"
  case "$sc" in
    extreme|balanced|silent|super-battery) ;;
    *) echo "Invalid scenario: $sc" >&2; exit 1 ;;
  esac

  ensure_permissions_bootstrap

  local pp="balanced"
  local shift_ec="0xC1"
  local fan_ec="0x0D"
  local fan_mode="auto"
  local super_bat="off"
  local enable_boost="1"
  local turbo_str="true"

  case "$sc" in
    extreme)
      pp="performance"
      shift_ec="0xC4"
      fan_ec="0x0D"
      fan_mode="auto"
      super_bat="off"
      enable_boost="1"
      turbo_str="true"
      ;;
    balanced)
      pp="balanced"
      shift_ec="0xC1"
      fan_ec="0x0D"
      fan_mode="auto"
      super_bat="off"
      enable_boost="1"
      turbo_str="true"
      ;;
    silent)
      pp="balanced"
      shift_ec="0xC1"
      fan_ec="0x1D"
      fan_mode="silent"
      super_bat="off"
      enable_boost="1"
      turbo_str="true"
      ;;
    super-battery)
      pp="power-saver"
      shift_ec="0xC2"
      fan_ec="0x1D"
      fan_mode="silent"
      super_bat="on"
      enable_boost="0"
      turbo_str="false"
      ;;
  esac

  if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl set "$pp" 2>/dev/null || true
  fi
  if command -v omarchy-powerprofiles-set >/dev/null 2>&1 && [[ $EUID -ne 0 ]]; then
    omarchy-powerprofiles-set autodetect "$pp" 2>/dev/null || true
  fi

  write_state_kv "scenario" "$sc"
  write_state_kv "fanMode" "$fan_mode"
  write_state_kv "coolerBoost" "false"
  write_state_kv "cpuTurbo" "$turbo_str"

  apply_cpu_boost_hw "$enable_boost"
  if [[ -d "$MSI_EC_DIR" ]]; then
    case "$sc" in
      extreme) echo "turbo" > "$MSI_EC_DIR/shift_mode" 2>/dev/null || true; echo "auto" > "$MSI_EC_DIR/fan_mode" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/super_battery" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true ;;
      balanced) echo "comfort" > "$MSI_EC_DIR/shift_mode" 2>/dev/null || true; echo "auto" > "$MSI_EC_DIR/fan_mode" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/super_battery" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true ;;
      silent) echo "comfort" > "$MSI_EC_DIR/shift_mode" 2>/dev/null || true; echo "silent" > "$MSI_EC_DIR/fan_mode" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/super_battery" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true ;;
      super-battery) echo "eco" > "$MSI_EC_DIR/shift_mode" 2>/dev/null || true; echo "silent" > "$MSI_EC_DIR/fan_mode" 2>/dev/null || true; echo "on" > "$MSI_EC_DIR/super_battery" 2>/dev/null || true; echo "off" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true ;;
    esac
  elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
    ec_set_bit 0x98 7 "off" || true
    ec_write_byte 0xD2 "$shift_ec" || true
    ec_write_byte 0xD4 "$fan_ec" || true
    ec_set_mask 0xEB 0x0F "$super_bat" || true
  fi
}

cmd_cooler_boost() {
  local target="${1:-toggle}"
  local cur
  cur=$(read_state_key "coolerBoost" "false")
  if [[ "$target" == "toggle" ]]; then
    if [[ "$cur" == "true" ]]; then
      target="off"
    else
      target="on"
    fi
  fi
  if [[ "$target" != "on" && "$target" != "off" ]]; then
    echo "Expected on|off|toggle" >&2
    exit 1
  fi

  ensure_permissions_bootstrap

  local bool_val="false"
  if [[ "$target" == "on" ]]; then
    bool_val="true"
  fi
  write_state_kv "coolerBoost" "$bool_val"
  if [[ "$target" == "on" ]]; then
    write_state_kv "fanMode" "advanced"
  else
    local prev_fm
    prev_fm=$(read_state_key "fanMode" "auto")
    if [[ "$prev_fm" == "advanced" ]]; then
      write_state_kv "fanMode" "auto"
    fi
  fi

  if [[ -w "$MSI_EC_DIR/cooler_boost" ]]; then
    echo "$target" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true
  elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
    ec_set_bit 0x98 7 "$target" || true
  fi
}

cmd_fan_mode() {
  local mode="${1:-auto}"
  case "$mode" in
    auto|silent|advanced) ;;
    *) echo "Invalid fan mode: $mode" >&2; exit 1 ;;
  esac

  ensure_permissions_bootstrap

  write_state_kv "fanMode" "$mode"
  if [[ "$mode" == "advanced" ]]; then
    write_state_kv "coolerBoost" "true"
    if [[ -w "$MSI_EC_DIR/fan_mode" ]]; then
      echo "advanced" > "$MSI_EC_DIR/fan_mode" 2>/dev/null || true
    fi
    if [[ -w "$MSI_EC_DIR/cooler_boost" ]]; then
      echo "on" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true
    elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
      ec_write_byte 0xD4 0x8D || true
      ec_set_bit 0x98 7 "on" || true
    fi
  else
    write_state_kv "coolerBoost" "false"
    if [[ -w "$MSI_EC_DIR/cooler_boost" ]]; then
      echo "off" > "$MSI_EC_DIR/cooler_boost" 2>/dev/null || true
    fi
    if [[ -w "$MSI_EC_DIR/fan_mode" ]]; then
      echo "$mode" > "$MSI_EC_DIR/fan_mode" 2>/dev/null || true
    elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
      ec_set_bit 0x98 7 "off" || true
      if [[ "$mode" == "silent" ]]; then
        ec_write_byte 0xD4 0x1D || true
      else
        ec_write_byte 0xD4 0x0D || true
      fi
    fi
  fi
}

cmd_turbo() {
  local target="${1:-toggle}"
  local cur_boost="1"
  if [[ -r /sys/devices/system/cpu/intel_pstate/no_turbo ]]; then
    local nt
    nt=$(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || echo "0")
    if [[ "$nt" == "1" ]]; then
      cur_boost="0"
    else
      cur_boost="1"
    fi
  elif [[ -r /sys/devices/system/cpu/cpufreq/boost ]]; then
    cur_boost=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo "1")
  fi

  if [[ "$target" == "toggle" ]]; then
    if [[ "$cur_boost" == "1" ]]; then
      target="off"
    else
      target="on"
    fi
  fi
  if [[ "$target" != "on" && "$target" != "off" ]]; then
    echo "Expected on|off|toggle" >&2
    exit 1
  fi

  ensure_permissions_bootstrap

  local enable_boost="1"
  local turbo_str="true"
  if [[ "$target" == "off" ]]; then
    enable_boost="0"
    turbo_str="false"
  fi
  write_state_kv "cpuTurbo" "$turbo_str"

  apply_cpu_boost_hw "$enable_boost"
}

cmd_mystic() {
  local mode="${1:-steady}"
  local hex="${2:-#FF1E1E}"
  local bright="${3:-100}"
  local speed="${4:-}"
  if [[ -z "$speed" ]]; then
    speed=$(read_state_key "mysticSpeed" "50")
  fi

  case "$mode" in
    steady|breathing|wave|off) ;;
    *) echo "Invalid mystic mode: $mode" >&2; exit 1 ;;
  esac
  if [[ ! "$hex" =~ ^#?[0-9A-Fa-f]{6}$ ]]; then
    hex="#FF1E1E"
  fi
  if [[ "$hex" != \#* ]]; then
    hex="#$hex"
  fi
  hex="${hex^^}"
  if [[ ! "$bright" =~ ^[0-9]+$ ]]; then
    bright=100
  fi
  if (( bright > 100 )); then
    bright=100
  fi
  if [[ ! "$speed" =~ ^[0-9]+$ ]]; then
    speed=50
  fi
  if (( speed < 5 )); then
    speed=5
  fi
  if (( speed > 100 )); then
    speed=100
  fi

  ensure_permissions_bootstrap

  write_state_kv "mysticMode" "$mode"
  write_state_kv "mysticColor" "$hex"
  write_state_kv "mysticBrightness" "$bright"
  write_state_kv "mysticSpeed" "$speed"

  apply_mystic_hw "$mode" "$hex" "$bright" "$speed"
}

cmd_battery_limit() {
  local limit="${1:-80}"
  case "$limit" in
    60|80|100) ;;
    *) echo "Invalid battery limit (expected 60, 80, or 100)" >&2; exit 1 ;;
  esac

  ensure_permissions_bootstrap

  write_state_kv "chargeLimit" "$limit"
  local start_limit=$(( limit - 10 ))
  for bat in /sys/class/power_supply/BAT*; do
    if [[ ! -d "$bat" ]]; then
      continue
    fi
    if [[ -w "$bat/charge_control_end_threshold" ]]; then
      if (( limit == 100 )); then
        echo 100 > "$bat/charge_control_end_threshold" 2>/dev/null || true
        if [[ -w "$bat/charge_control_start_threshold" ]]; then
          echo "$start_limit" > "$bat/charge_control_start_threshold" 2>/dev/null || true
        fi
      else
        if [[ -w "$bat/charge_control_start_threshold" ]]; then
          echo "$start_limit" > "$bat/charge_control_start_threshold" 2>/dev/null || true
        fi
        echo "$limit" > "$bat/charge_control_end_threshold" 2>/dev/null || true
      fi
    fi
  done

  if [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
    local ec_reg ec_val
    ec_reg=$(detect_battery_ec_reg)
    ec_val=$(printf '0x%02X' $(( 128 + limit )))
    ec_write_byte "$ec_reg" "$ec_val" || true
  fi
}

cmd_switch() {
  local name="$1" target="${2:-toggle}"
  local state_key=""
  case "$name" in
    webcam) state_key="webcamEnabled" ;;
    fn-swap) state_key="fnWinSwap" ;;
    usb-share) state_key="usbPowerShare" ;;
    *) echo "Unknown switch: $name" >&2; exit 1 ;;
  esac

  local cur_default="false"
  if [[ "$name" == "webcam" ]]; then
    cur_default="true"
  fi
  local cur
  cur=$(read_state_key "$state_key" "$cur_default")
  if [[ "$target" == "toggle" ]]; then
    if [[ "$cur" == "true" ]]; then
      target="off"
    else
      target="on"
    fi
  fi
  if [[ "$target" != "on" && "$target" != "off" ]]; then
    echo "Expected on|off|toggle" >&2
    exit 1
  fi

  ensure_permissions_bootstrap

  local bool_val="false"
  if [[ "$target" == "on" ]]; then
    bool_val="true"
  fi
  write_state_kv "$state_key" "$bool_val"

  if [[ "$name" == "webcam" ]]; then
    if [[ -w "$MSI_EC_DIR/webcam" ]]; then
      echo "$target" > "$MSI_EC_DIR/webcam" 2>/dev/null || true
    elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
      if [[ "$target" == "on" ]]; then
        ec_set_bit 0x2E 1 "on" || true
        ec_set_bit 0x2F 1 "off" || true
        if [[ $EUID -eq 0 ]]; then
          modprobe uvcvideo 2>/dev/null || true
        fi
      else
        ec_set_bit 0x2E 1 "off" || true
        ec_set_bit 0x2F 1 "on" || true
      fi
    fi
  elif [[ "$name" == "fn-swap" ]]; then
    if [[ -w "$MSI_EC_DIR/win_key" ]]; then
      if [[ "$target" == "on" ]]; then
        echo "right" > "$MSI_EC_DIR/win_key" 2>/dev/null || true
      else
        echo "left" > "$MSI_EC_DIR/win_key" 2>/dev/null || true
      fi
    elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
      ec_set_bit 0xE8 4 "$target" || true
    fi
  elif [[ "$name" == "usb-share" ]]; then
    if [[ -w "$MSI_EC_DIR/usb_power" ]]; then
      echo "$target" > "$MSI_EC_DIR/usb_power" 2>/dev/null || true
    elif [[ -w "$EC_IO" || $EUID -eq 0 ]]; then
      ec_set_bit 0xBF 5 "$target" || true
    fi
  fi
}

cmd_boot_init() {
  ensure_permissions_bootstrap
  local saved_mode saved_color saved_bright saved_speed
  saved_mode=$(read_state_key "mysticMode" "")
  saved_color=$(read_state_key "mysticColor" "#00E5FF")
  saved_bright=$(read_state_key "mysticBrightness" "100")
  saved_speed=$(read_state_key "mysticSpeed" "50")
  if [[ -n "$saved_mode" ]]; then
    apply_mystic_hw "$saved_mode" "$saved_color" "$saved_bright" "$saved_speed" || true
  fi
}

cmd_setup_permissions() {
  if [[ $EUID -ne 0 ]]; then
    echo "setup-permissions must be run as root (via pkexec)" >&2
    exit 1
  fi
  ensure_permissions_bootstrap
  cmd_boot_init
  echo "Direct MSI hardware access enabled."
}

cmd_json() {
  python3 - "$STATE_FILE" "$SCRIPT_PATH" "$EC_IO" <<'PY'
import glob, json, os, re, subprocess, sys

state_file = sys.argv[1]
script_path = sys.argv[2]
ec_io_path = sys.argv[3]

def read_file(path, default=""):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except Exception:
        return default

def read_int(path, default=0):
    try:
        return int(read_file(path, str(default)))
    except Exception:
        return default

saved = {}
if os.path.isfile(state_file):
    try:
        with open(state_file, "r", encoding="utf-8") as f:
            saved = json.load(f)
    except Exception:
        saved = {}

ec_bytes = None
if os.access(ec_io_path, os.R_OK):
    try:
        with open(ec_io_path, "rb") as f:
            data = f.read(256)
            if len(data) == 256:
                ec_bytes = data
    except Exception:
        ec_bytes = None

# 1. System / DMI
model = read_file("/sys/devices/virtual/dmi/id/product_name", "MSI Computer")
board = read_file("/sys/devices/virtual/dmi/id/board_name", "MSI")
bios = read_file("/sys/devices/virtual/dmi/id/bios_version", "")
chassis_type = read_int("/sys/devices/virtual/dmi/id/chassis_type", 10)
chassis = "laptop" if chassis_type in (8, 9, 10, 11, 14, 30, 31, 32) else "desktop"

ec_fw = "17T2EMS1.110" if board == "MS-17T2" else ""
is_msi_ec_fw = False
if ec_bytes:
    try:
        raw_fw = ec_bytes[0xA0:0xAC].decode("ascii", errors="ignore").strip("\x00 ")
        if len(raw_fw) >= 8:
            ec_fw = raw_fw
            if re.match(r"^[0-9A-Z]{4}EMS[0-9]\.[0-9A-Z]{3}$", raw_fw):
                is_msi_ec_fw = True
    except Exception:
        pass

# 2. CPU Telemetry
def read_cpu_stat():
    line = read_file("/proc/stat", "").splitlines()
    if not line:
        return (0, 0)
    parts = [int(x) for x in line[0].split()[1:9]]
    idle = parts[3] + (parts[4] if len(parts) > 4 else 0)
    total = sum(parts)
    return (idle, total)

idle1, total1 = read_cpu_stat()

cpu_temp = 0.0
mem_temp = 0.0
nvme_temp = 0.0
fans = {"fan1Rpm": 0, "fan2Rpm": 0, "fan3Rpm": 0, "fan4Rpm": 0}

for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
    name = read_file(os.path.join(hw, "name"), "")
    if name in ("coretemp", "k10temp", "zenpower"):
        t = read_int(os.path.join(hw, "temp1_input"), 0)
        if t > 0:
            cpu_temp = round(t / 1000.0, 1)
    elif name == "acpitz" and cpu_temp == 0.0:
        t = read_int(os.path.join(hw, "temp1_input"), 0)
        if t > 0:
            cpu_temp = round(t / 1000.0, 1)
    elif name in ("spd5118", "jc42"):
        t = read_int(os.path.join(hw, "temp1_input"), 0)
        if t > 0:
            mem_temp = max(mem_temp, round(t / 1000.0, 1))
    elif name == "nvme":
        t = read_int(os.path.join(hw, "temp1_input"), 0)
        if t > 0:
            nvme_temp = round(t / 1000.0, 1)
    elif name in ("msi_wmi_platform", "nct6775", "nct6687"):
        for idx in (1, 2, 3, 4):
            rpm = read_int(os.path.join(hw, f"fan{idx}_input"), 0)
            if rpm > 0 or fans[f"fan{idx}Rpm"] == 0:
                fans[f"fan{idx}Rpm"] = rpm

if fans["fan1Rpm"] == 0 and os.path.exists("/sys/devices/platform/msi-ec/cpu/realtime_fan_speed"):
    fans["fan1Rpm"] = read_int("/sys/devices/platform/msi-ec/cpu/realtime_fan_speed", 0)
if fans["fan2Rpm"] == 0 and os.path.exists("/sys/devices/platform/msi-ec/gpu/realtime_fan_speed"):
    fans["fan2Rpm"] = read_int("/sys/devices/platform/msi-ec/gpu/realtime_fan_speed", 0)

freqs = [read_int(p, 0) for p in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")]
freqs = [f for f in freqs if f > 0]
avg_ghz = round((sum(freqs) / len(freqs)) / 1000000.0, 2) if freqs else 0.0
cores = len(glob.glob("/sys/devices/system/cpu/cpu[0-9]*")) or 1

cpu_turbo = True
if os.path.exists("/sys/devices/system/cpu/intel_pstate/no_turbo"):
    cpu_turbo = (read_file("/sys/devices/system/cpu/intel_pstate/no_turbo", "0") == "0")
elif os.path.exists("/sys/devices/system/cpu/cpufreq/boost"):
    cpu_turbo = (read_file("/sys/devices/system/cpu/cpufreq/boost", "1") == "1")

# 3. GPU Telemetry & Driver check (supports NVIDIA via nvidia-smi & AMD via sysfs)
dgpu_runtime_status = "active"
for pci_dev in sorted(glob.glob("/sys/bus/pci/devices/*")):
    pci_class = read_file(os.path.join(pci_dev, "class"), "")
    pci_vendor = read_file(os.path.join(pci_dev, "vendor"), "")
    if pci_class.startswith(("0x0300", "0x0302")) and pci_vendor == "0x10de":
        dgpu_runtime_status = read_file(os.path.join(pci_dev, "power/runtime_status"), "active")
        break

gpu = {
    "present": False,
    "name": "Discrete GPU",
    "driverVersion": "",
    "cudaVersion": "",
    "tempC": 0,
    "utilPct": 0,
    "powerW": 0.0,
    "powerCapW": 0.0,
    "vramUsedMib": 0,
    "vramTotalMib": 0,
    "pstate": "",
    "runtimeStatus": dgpu_runtime_status,
    "mode": "Hybrid / Optimus" if chassis == "laptop" else "Discrete PCIe",
    "displays": []
}

for conn in sorted(glob.glob("/sys/class/drm/card*-*")):
    if read_file(os.path.join(conn, "status")) == "connected":
        short_name = re.sub(r"^card\d+-", "", os.path.basename(conn))
        if short_name not in gpu["displays"]:
            gpu["displays"].append(short_name)

try:
    out = subprocess.check_output(
        [
            "nvidia-smi",
            "--query-gpu=name,driver_version,temperature.gpu,utilization.gpu,power.draw,power.default_limit,memory.used,memory.total,pstate",
            "--format=csv,noheader,nounits"
        ],
        stderr=subprocess.DEVNULL,
        timeout=1.5,
        text=True
    ).strip()
    if out:
        first = out.splitlines()[0]
        parts = [p.strip() for p in first.split(",")]
        if len(parts) >= 9:
            gpu["present"] = True
            gpu["name"] = parts[0].replace("NVIDIA ", "")
            gpu["driverVersion"] = parts[1]
            gpu["tempC"] = int(float(parts[2])) if parts[2] not in ("[N/A]", "") else 0
            gpu["utilPct"] = int(float(parts[3])) if parts[3] not in ("[N/A]", "") else 0
            gpu["powerW"] = round(float(parts[4]), 1) if parts[4] not in ("[N/A]", "") else 0.0
            gpu["powerCapW"] = round(float(parts[5]), 1) if parts[5] not in ("[N/A]", "") else 0.0
            gpu["vramUsedMib"] = int(float(parts[6])) if parts[6] not in ("[N/A]", "") else 0
            gpu["vramTotalMib"] = int(float(parts[7])) if parts[7] not in ("[N/A]", "") else 0
            gpu["pstate"] = parts[8]
except Exception:
    pass

if not gpu["present"]:
    for card_dev in sorted(glob.glob("/sys/class/drm/card[0-9]/device")):
        if read_file(os.path.join(card_dev, "vendor")) == "0x1002" and os.path.exists(os.path.join(card_dev, "gpu_busy_percent")):
            gpu["present"] = True
            gpu["name"] = "AMD Radeon GPU"
            gpu["driverVersion"] = "amdgpu"
            gpu["utilPct"] = read_int(os.path.join(card_dev, "gpu_busy_percent"), 0)
            v_used = read_int(os.path.join(card_dev, "mem_info_vram_used"), 0)
            v_tot = read_int(os.path.join(card_dev, "mem_info_vram_total"), 0)
            gpu["vramUsedMib"] = int(v_used // (1024 * 1024))
            gpu["vramTotalMib"] = int(v_tot // (1024 * 1024))
            for hw in glob.glob(os.path.join(card_dev, "hwmon/hwmon*")):
                t = read_int(os.path.join(hw, "temp1_input"), 0)
                if t > 0:
                    gpu["tempC"] = int(round(t / 1000.0))
                p = read_int(os.path.join(hw, "power1_average"), 0) or read_int(os.path.join(hw, "power1_input"), 0)
                if p > 0:
                    gpu["powerW"] = round(p / 1000000.0, 1)
            break

idle2, total2 = read_cpu_stat()
dt = max(1, total2 - total1)
cpu_usage = int(round(100.0 * (1.0 - max(0, idle2 - idle1) / dt)))

# 4. Memory usage
mem_total_kib = 0
mem_avail_kib = 0
for line in read_file("/proc/meminfo", "").splitlines():
    if line.startswith("MemTotal:"):
        mem_total_kib = int(line.split()[1])
    elif line.startswith("MemAvailable:"):
        mem_avail_kib = int(line.split()[1])
mem_used_kib = max(0, mem_total_kib - mem_avail_kib)
mem_total_gib = round(mem_total_kib / (1024.0 * 1024.0), 1)
mem_used_gib = round(mem_used_kib / (1024.0 * 1024.0), 1)
mem_pct = int(round(100.0 * mem_used_kib / max(1, mem_total_kib)))

# 5. Battery Master
bat_paths = sorted(glob.glob("/sys/class/power_supply/BAT*"))
battery = {
    "present": False,
    "capacityPct": 0,
    "status": "AC Power",
    "healthPct": 100,
    "cycles": 0,
    "powerW": 0.0,
    "chargeLimit": int(saved.get("chargeLimit", 100))
}
if bat_paths:
    bp = bat_paths[0]
    battery["present"] = True
    battery["capacityPct"] = read_int(os.path.join(bp, "capacity"), 0)
    battery["status"] = read_file(os.path.join(bp, "status"), "Unknown")
    battery["cycles"] = read_int(os.path.join(bp, "cycle_count"), 0)
    full = read_int(os.path.join(bp, "charge_full"), 0) or read_int(os.path.join(bp, "energy_full"), 0)
    design = read_int(os.path.join(bp, "charge_full_design"), 0) or read_int(os.path.join(bp, "energy_full_design"), 0)
    if full > 0 and design > 0:
        battery["healthPct"] = min(100, int(round(100.0 * full / design)))
    cur_now = read_int(os.path.join(bp, "current_now"), 0)
    volt_now = read_int(os.path.join(bp, "voltage_now"), 0)
    power_now = read_int(os.path.join(bp, "power_now"), 0)
    if power_now > 0:
        battery["powerW"] = round(power_now / 1000000.0, 1)
    elif cur_now > 0 and volt_now > 0:
        battery["powerW"] = round((cur_now / 1000000.0) * (volt_now / 1000000.0), 1)
    if os.path.exists(os.path.join(bp, "charge_control_end_threshold")):
        battery["chargeLimit"] = read_int(os.path.join(bp, "charge_control_end_threshold"), battery["chargeLimit"])
    elif ec_bytes is not None and is_msi_ec_fw:
        for reg in (0xD7, 0xEF):
            if (ec_bytes[reg] & 0x80) and (50 <= (ec_bytes[reg] & 0x7F) <= 100):
                battery["chargeLimit"] = ec_bytes[reg] & 0x7F
                break

# 6. Power profile & MSI Scenario
power_profile = "balanced"
try:
    pp_out = subprocess.check_output(["powerprofilesctl", "get"], stderr=subprocess.DEVNULL, timeout=1.0, text=True).strip()
    if pp_out:
        power_profile = pp_out
except Exception:
    pass

saved_scenario = saved.get("scenario", "")
if saved_scenario in ("extreme", "balanced", "silent", "super-battery"):
    scenario = saved_scenario
    if power_profile == "performance" and scenario != "extreme":
        scenario = "extreme"
    elif power_profile == "power-saver" and scenario != "super-battery":
        scenario = "super-battery"
    elif power_profile == "balanced" and scenario in ("extreme", "super-battery"):
        scenario = "balanced"
else:
    if power_profile == "performance":
        scenario = "extreme"
    elif power_profile == "power-saver":
        scenario = "super-battery"
    else:
        scenario = "balanced"

cooler_boost = (saved.get("coolerBoost", "false") == "true")
if os.path.exists("/sys/devices/platform/msi-ec/cooler_boost"):
    cb_sys = read_file("/sys/devices/platform/msi-ec/cooler_boost", "off")
    cooler_boost = (cb_sys in ("on", "1"))
elif ec_bytes is not None and is_msi_ec_fw:
    cooler_boost = bool(ec_bytes[0x98] & 0x80)
elif fans["fan1Rpm"] >= 5200 or fans["fan2Rpm"] >= 5200:
    cooler_boost = True

fan_mode = saved.get("fanMode", "auto")
if os.path.exists("/sys/devices/platform/msi-ec/fan_mode"):
    fm_sys = read_file("/sys/devices/platform/msi-ec/fan_mode", "")
    if fm_sys in ("auto", "silent", "advanced"):
        fan_mode = fm_sys
elif ec_bytes is not None and is_msi_ec_fw:
    raw_fm = ec_bytes[0xD4]
    if raw_fm == 0x1D:
        fan_mode = "silent"
    elif raw_fm == 0x8D:
        fan_mode = "advanced"
    elif raw_fm == 0x0D:
        fan_mode = "auto"
if cooler_boost:
    fan_mode = "advanced"

# 7. Mystic Light detection
mystic_present = False
mystic_name = ""
mystic_id = ""
mystic_hidraw_writable = False
for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
    uevent = read_file(os.path.join(h, "device/uevent"), "")
    m = re.search(r"00001462:0000(1603|1562|1563|1564)", uevent, re.IGNORECASE)
    if m:
        mystic_present = True
        mystic_id = "1462:" + m.group(1).upper()
        for line in uevent.splitlines():
            if line.startswith("HID_NAME="):
                mystic_name = line.split("=", 1)[1].strip()
        dev_node = "/dev/" + os.path.basename(h)
        mystic_hidraw_writable = os.access(dev_node, os.W_OK)
        break

if not mystic_present and (glob.glob("/sys/class/leds/*kbd_backlight*") or os.path.exists("/sys/devices/platform/msi-ec/kbd_backlight")):
    mystic_present = True
    mystic_name = "MSI Keyboard Backlight"
    mystic_id = "sysfs-led"
    mystic_hidraw_writable = True

mystic = {
    "present": mystic_present,
    "deviceName": mystic_name or "MSI MysticLight",
    "deviceId": mystic_id,
    "mode": saved.get("mysticMode", "steady"),
    "colorHex": saved.get("mysticColor", "#00E5FF"),
    "brightnessPct": int(saved.get("mysticBrightness", 100)),
    "speedPct": int(saved.get("mysticSpeed", 50))
}

# 8. Drivers & Kernel Module Health (Intel, AMD, NVIDIA, MediaTek, Qualcomm, Realtek)
mods = read_file("/proc/modules", "")
has_nvidia_mod = "nvidia " in mods and "nvidia_drm " in mods
has_intel_igpu = ("i915 " in mods) or ("xe " in mods)
has_amd_gpu = "amdgpu " in mods
has_igpu_mod = has_intel_igpu or has_amd_gpu
igpu_detail = "Intel Graphics (i915 / xe)" if has_intel_igpu else ("AMD Radeon Graphics (amdgpu)" if has_amd_gpu else "Not loaded")

has_msi_wmi_platform = "msi_wmi_platform " in mods
has_msi_wmi = "msi_wmi " in mods
has_msi_ec = os.path.isdir("/sys/devices/platform/msi-ec")
has_ec_sys = "ec_sys " in mods or os.path.exists(ec_io_path)

has_audio = any(m in mods for m in ("snd_sof", "sof_audio_pci", "snd_hda_intel", "snd_soc_"))
net_parts = []
if "iwlwifi " in mods:
    net_parts.append("Intel Wi-Fi")
elif any(m in mods for m in ("mt7921e ", "mt7925e ", "mt76 ")):
    net_parts.append("MediaTek Wi-Fi")
elif any(m in mods for m in ("ath11k", "ath12k", "ath10k")):
    net_parts.append("Qualcomm Wi-Fi")
elif any(m in mods for m in ("rtw89", "rtw88")):
    net_parts.append("Realtek Wi-Fi")

if any(m in mods for m in ("r8169 ", "r8125 ")):
    net_parts.append("Realtek LAN")
elif any(m in mods for m in ("igc ", "e1000e ")):
    net_parts.append("Intel LAN")

has_audio_net = has_audio and len(net_parts) > 0
audio_label = "SOF Audio" if ("snd_sof" in mods or "sof_audio_pci" in mods) else "HD Audio"
audio_net_detail = " + ".join([audio_label] + net_parts) if has_audio_net else "Check audio/network modules"

ec_writable = os.access("/sys/devices/platform/msi-ec/cooler_boost", os.W_OK) or os.access(ec_io_path, os.W_OK)
ec_backend = "msi-ec" if has_msi_ec else ("ec_sys (direct EC)" if ec_writable else "msi_wmi_platform")

drivers = {
    "nvidiaOk": bool(gpu["present"] and (has_nvidia_mod or has_amd_gpu)),
    "nvidiaDetail": f"v{gpu['driverVersion']} · {gpu['name']}" if gpu["present"] else "Not loaded",
    "igpuOk": has_igpu_mod,
    "igpuDetail": igpu_detail,
    "msiWmiOk": has_msi_wmi_platform or has_msi_wmi,
    "msiWmiDetail": "msi_wmi_platform + msi_wmi active" if (has_msi_wmi_platform and has_msi_wmi) else ("msi_wmi active" if has_msi_wmi else "Not loaded"),
    "msiEcOk": has_msi_ec or has_ec_sys or has_msi_wmi_platform,
    "msiEcDetail": f"Active ({ec_backend})",
    "mysticOk": mystic_present,
    "mysticDetail": f"{mystic_name} ({mystic_id})" if mystic_present else "No RGB controller detected",
    "audioNetOk": has_audio_net,
    "audioNetDetail": audio_net_detail
}

webcam_enabled = saved.get("webcamEnabled", "true") != "false"
fn_win_swap = saved.get("fnWinSwap", "false") == "true"
usb_power_share = saved.get("usbPowerShare", "false") == "true"
if os.path.exists("/sys/devices/platform/msi-ec/webcam"):
    webcam_enabled = read_file("/sys/devices/platform/msi-ec/webcam", "on") in ("on", "1")
elif ec_bytes is not None and is_msi_ec_fw:
    webcam_enabled = bool(ec_bytes[0x2E] & 0x02)

if os.path.exists("/sys/devices/platform/msi-ec/win_key"):
    fn_win_swap = read_file("/sys/devices/platform/msi-ec/win_key", "left") == "right"
elif ec_bytes is not None and is_msi_ec_fw:
    fn_win_swap = bool(ec_bytes[0xE8] & 0x10)

if os.path.exists("/sys/devices/platform/msi-ec/usb_power"):
    usb_power_share = read_file("/sys/devices/platform/msi-ec/usb_power", "off") in ("on", "1")
elif ec_bytes is not None and is_msi_ec_fw:
    usb_power_share = bool(ec_bytes[0xBF] & 0x20)

hardware = {
    "webcamEnabled": webcam_enabled,
    "fnWinSwap": fn_win_swap,
    "usbPowerShare": usb_power_share,
    "ecDirectReady": bool(ec_writable and (mystic_hidraw_writable or not mystic_present)),
    "ecBackend": ec_backend
}

payload = {
    "model": model,
    "board": board,
    "bios": bios,
    "ecFirmware": ec_fw,
    "chassis": chassis,
    "scenario": scenario,
    "powerProfile": power_profile,
    "coolerBoost": cooler_boost,
    "fanMode": fan_mode,
    "cpuTurbo": cpu_turbo,
    "cpu": {
        "tempC": cpu_temp,
        "usagePct": cpu_usage,
        "freqGhz": avg_ghz,
        "cores": cores
    },
    "gpu": gpu,
    "fans": fans,
    "memory": {
        "usedGib": mem_used_gib,
        "totalGib": mem_total_gib,
        "usagePct": mem_pct,
        "tempC": mem_temp
    },
    "nvme": {
        "tempC": nvme_temp
    },
    "battery": battery,
    "mystic": mystic,
    "hardware": hardware,
    "drivers": drivers
}

print(json.dumps(payload))
PY
}

cmd_status() {
  cmd_json | jq .
}

case "${1:-json}" in
  json) cmd_json ;;
  status) cmd_status ;;
  scenario) shift; cmd_scenario "$@" ;;
  cooler-boost) shift; cmd_cooler_boost "$@" ;;
  fan-mode) shift; cmd_fan_mode "$@" ;;
  turbo) shift; cmd_turbo "$@" ;;
  mystic) shift; cmd_mystic "$@" ;;
  battery-limit) shift; cmd_battery_limit "$@" ;;
  webcam) shift; cmd_switch webcam "$@" ;;
  fn-swap) shift; cmd_switch fn-swap "$@" ;;
  usb-share) shift; cmd_switch usb-share "$@" ;;
  setup-permissions) cmd_setup_permissions ;;
  --boot-init) cmd_boot_init ;;
  *)
    echo "Usage: msi-center-ctl {json|status|scenario|cooler-boost|fan-mode|turbo|mystic|battery-limit|webcam|fn-swap|usb-share|setup-permissions}" >&2
    exit 1
    ;;
esac
